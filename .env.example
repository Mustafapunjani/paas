# Copy these into Vercel: Project > Settings > Environment Variables.
# For local testing with `vercel dev`, copy this file to .env and fill it in.

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Any long random text. Protects the daily cleanup job.
CRON_SECRET=make-up-a-long-random-string-here
